  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayoutMain">
    <property name="leftMargin"><number>30</number></property>
    <property name="topMargin"><number>30</number></property>
    <property name="rightMargin"><number>30</number></property>
    <property name="bottomMargin"><number>30</number></property>
    <item>
     <widget class="QLabel" name="lblTitle">
      <property name="text">
       <string>📥 FORM PEMINJAMAN BUKU</string>
      </property>
      <property name="alignment">
       <set>Qt::AlignCenter</set>
      </property>
     </widget>
    </item>
    <item>
     <layout class="QHBoxLayout" name="horizontalLayoutMain">
      <item>
       <layout class="QVBoxLayout" name="verticalLayoutInput">
        <item>
         <widget class="QLabel" name="lblIdPinjam"><property name="text"><string>ID Pinjam:</string></property></widget>
        </item>
        <item>
         <widget class="QLineEdit" name="txtIdPinjam">
          <property name="placeholderText"><string>Contoh: PJ001</string></property>
